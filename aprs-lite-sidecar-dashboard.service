[Unit]
Description=APRS Lite Sidecar Dashboard
After=network-online.target aprs-direwolf.service
Wants=network-online.target aprs-direwolf.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/aprs-sidecar-dashboard
Environment=DB_PATH=/home/pi/aprs-sidecar-dashboard/data/sidecar.db
Environment=CONFIG_PATH=/opt/aprs-lite/config.env
Environment=DASHBOARD_HOST=0.0.0.0
Environment=DASHBOARD_PORT=5080
Environment=SERVICE_NAME=aprs-direwolf
Environment=TUI_SERVICE=aprs-lite-tui
Environment=WATCHDOG_SERVICE=aprs-watchdog
Environment=JOURNAL_UNIT=aprs-direwolf
ExecStartPre=-/bin/bash -c 'pgrep -f "gunicorn.*app:app" | xargs -r kill -TERM 2>/dev/null; sleep 1; pgrep -f "gunicorn.*app:app" | xargs -r kill -9 2>/dev/null; exit 0'
ExecStart=/home/pi/aprs-sidecar-dashboard/venv/bin/gunicorn \
    --worker-class eventlet -w 1 \
    --bind 0.0.0.0:5080 \
    --timeout 120 \
    --access-logfile - --error-logfile - \
    app:app
Restart=always
RestartSec=5
KillMode=control-group
CPUQuota=50%
MemoryMax=256M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aprs-lite-sidecar-dashboard

[Install]
WantedBy=multi-user.target
